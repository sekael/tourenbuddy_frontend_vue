# Local dev secrets for `wrangler dev`. Copy to .dev.vars and fill values.
# .dev.vars is gitignored — never commit real secrets.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@localhost
NOTIFICATIONS_ENABLED=true

# Must match SEND_EMAIL_HOOK_SECRET in supabase/.env. Format: "v1,whsec_<base64>".
# Generate: echo "v1,whsec_$(openssl rand -base64 48 | tr -d '\n')"
SEND_EMAIL_HOOK_SECRET=

# Brevo transactional API key — Brevo dashboard → SMTP & API → API Keys tab.
# (NOT the SMTP key used for SMTP relay.)
BREVO_API_KEY=

# Numeric Brevo template IDs — Transactional → Templates → template detail page.
BREVO_TEMPLATE_EN=4
BREVO_TEMPLATE_DE=3
BREVO_TEMPLATE_FRIEND_RECEIVED_EN=6
BREVO_TEMPLATE_FRIEND_RECEIVED_DE=5
BREVO_TEMPLATE_FRIEND_RESPONDED_EN=8
BREVO_TEMPLATE_FRIEND_RESPONDED_DE=7
BREVO_TEMPLATE_TOUR_UPDATES_EN=9
BREVO_TEMPLATE_TOUR_UPDATES_DE=10
BREVO_TEMPLATE_TOUR_INTEREST_EN=12
BREVO_TEMPLATE_TOUR_INTEREST_DE=11
BREVO_TEMPLATE_TOUR_LINK_DELETED_EN=13
BREVO_TEMPLATE_TOUR_LINK_DELETED_DE=14
