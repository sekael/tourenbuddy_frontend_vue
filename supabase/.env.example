# Supabase CLI loads supabase/.env automatically and substitutes env(VAR_NAME) tokens
# in supabase/config.toml. Copy this file to supabase/.env and fill in real values.
# supabase/.env is gitignored — never commit secrets.
#
# Apply changes: supabase stop && supabase start

# --- Brevo SMTP (auth emails: OTP, magic link, confirmations) ---
# Brevo dashboard → SMTP & API → SMTP tab.
# Login is the address shown under "Login" (typically your Brevo account email).
BREVO_SMTP_LOGIN=
# Password is an SMTP key — generate under SMTP & API → SMTP Keys → "Generate a new SMTP key".
# (NOT a regular API key from the API Keys tab — those don't authenticate SMTP.)
BREVO_SMTP_API_KEY=
# Verified sender address in Brevo (e.g. no-reply@tourenbuddy.ch).
BREVO_SENDER_EMAIL=

# --- Twilio Verify (auth SMS: phone verification) ---
# Twilio Console → Account Info.
TWILIO_ACCOUNT_SID=
# Twilio Verify Service SID (Console → Verify → Services → your service, starts with "VA").
TWILIO_VERIFY_SERVICE_SID=
# Twilio Auth Token. Variable name fixed by Supabase CLI default in config.toml.
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=

# Send Email Hook shared secret — must match SEND_EMAIL_HOOK_SECRET in services/email-hook
# Format: "v1,whsec_<base64>" (Supabase webhook signature scheme).
SEND_EMAIL_HOOK_SECRET=

